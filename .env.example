# App
APP_ENV=development
APP_SECRET=change-me-in-production
FRONTEND_ORIGIN=http://localhost:3000
HOST_BIND_ADDRESS=127.0.0.1

# Database
POSTGRES_DB=aitutor
POSTGRES_USER=aitutor
# Leave DATABASE_URL blank to have Compose derive it from POSTGRES_*.
# In this mode, POSTGRES_PASSWORD must be URL-safe.
# For a real pilot, use a long random, private, non-default URL-safe password,
# for example using only A-Z, a-z, 0-9, _ and -.
# If the password contains URL-reserved characters, set DATABASE_URL explicitly
# with the password correctly percent-encoded and all connection fields matching.
# This tracked example uses only a development placeholder; never put a real secret here.
POSTGRES_PASSWORD=local-dev-only-change-me
DATABASE_URL=

# Docker json-file log rotation (bounded local container logs; not a 30-day retention guarantee)
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# OpenAI
OPENAI_API_KEY=
# Optional base URL for OpenAI-compatible providers
OPENAI_BASE_URL=
# Structured API mode: responses or chat_completions
OPENAI_API_MODE=responses
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
